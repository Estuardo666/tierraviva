---
import "../styles/global.css";

import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import ValueProp from "../components/ValueProp.astro";
import Manifesto from "../components/Manifesto.astro";
import Origin from "../components/Origin.astro";
import Flower from "../components/Flower.astro";
import Process from "../components/Process.astro";
import Product from "../components/Product.astro";
import Traceability from "../components/Traceability.astro";
import Allies from "../components/Allies.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import EnquiryModal from "../components/EnquiryModal.astro";

const title = "Tierra Viva Cacao Co. Regenerative Cacao at Origin.";
const description =
	"Nacional fino de aroma cacao from Chone, Manabí, Ecuador. Centralized fermentation, lot-level traceability, regenerative agroforestry.";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="generator" content={Astro.generator} />

		<link rel="preload" href="/fonts/haqmuse.otf" as="font" type="font/otf" crossorigin />
		<link rel="preload" href="/fonts/AbroSans-Regular.ttf" as="font" type="font/ttf" crossorigin />

		{/* Runs before first paint: reveal styles only apply when JS is alive. */}
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
	</head>

	<body>
		<a href="#origin" class="skip">Skip to content</a>

		<Nav />

		<main>
			<Hero />
			<ValueProp />
			<Manifesto />
			<Origin />
			<Flower />
			<Process />
			<Product />
			<Traceability />
			<Allies />
			<Contact />
		</main>

		<Footer />

		<EnquiryModal />

		<style>
			.skip {
				position: absolute;
				inset-block-start: -100%;
				inset-inline-start: 1rem;
				z-index: 100;
				background: var(--color-orange);
				color: var(--color-blue);
				padding: 0.75rem 1.25rem;
				font-size: 0.8125rem;
				font-weight: 700;
			}

			.skip:focus {
				inset-block-start: 1rem;
			}
		</style>

		<script>
			// Sequential entry: inside a [data-stagger] block, anything that has
			// not been given an explicit delay is spaced by document order, so
			// a section resolves as one movement instead of five simultaneous
			// ones. Authored delays always win.
			document.querySelectorAll("[data-stagger]").forEach((block) => {
				block.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el, i) => {
					if (!el.style.getPropertyValue("--reveal-delay")) {
						el.style.setProperty("--reveal-delay", `${i * 90}ms`);
					}
				});
			});

			// One observer drives every reveal on the page: section blocks, image
			// wipes, and icon line drawing all key off the same `is-in` class.
			const targets = document.querySelectorAll("[data-reveal], [data-img-reveal], [data-draw]");
			const imageTargets = document.querySelectorAll<HTMLElement>("[data-img-reveal]");
			const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			const revealAll = () => targets.forEach((el) => el.classList.add("is-in"));

			// Image loading is the reliable fallback for lazy media. Some browsers
			// can deliver the observer's initial non-intersecting batch but miss the
			// later intersection after a long scroll. Revealing on load keeps the
			// wipe tied to the real asset and prevents a loaded image remaining
			// clipped or transparent forever.
			imageTargets.forEach((target) => {
				const image = target.querySelector<HTMLImageElement>("img");
				const revealImage = () => target.classList.add("is-in");

				if (!image || image.complete) {
					revealImage();
					return;
				}

				image.addEventListener("load", revealImage, { once: true });
				image.addEventListener("error", revealImage, { once: true });
			});

			if (reduce || !("IntersectionObserver" in window)) {
				revealAll();
			} else {
				let ran = false;

				const observer = new IntersectionObserver(
					(entries) => {
						ran = true;
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add("is-in");
							observer.unobserve(entry.target);
						});
					},
					{ threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
				);

				targets.forEach((el) => observer.observe(el));

				// Safety net, and the distinction matters: we are testing whether
				// the observer RUNS, not whether it has reported something useful.
				// An observer always delivers a first callback for everything it
				// observes, intersecting or not. So if `ran` is still false, the
				// observer is broken and we show the page. Waiting on a reveal
				// instead would fire on every visit, because the reader is still
				// at the hero and nothing below it has intersected yet, and that
				// silently marks the whole page as already revealed.
				window.setTimeout(() => {
					if (!ran) revealAll();
				}, 2500);
			}
		</script>
	</body>
</html>
