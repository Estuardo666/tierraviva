---
/**
 * Line icons drawn from the "Gráficos de apoyo" sheet in the brand manual.
 * Hand-drawn on purpose: the manual defines its own set, so pulling glyphs
 * from Phosphor or Tabler here would break brand rather than follow it.
 * Thin stroke, organic geometry, accent colour inherited from currentColor.
 */
interface Props {
	name: "pod" | "beans" | "sprout" | "flower" | "lattice";
	class?: string;
	[key: string]: unknown;
}

const { name, class: className = "", ...rest } = Astro.props;
---

<svg
	class={className}
	{...rest}
	viewBox="0 0 48 48"
	fill="none"
	stroke="currentColor"
	stroke-width="1.4"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{
		name === "pod" && (
			<>
				<path pathLength="1" d="M24 6c7 6 11 14 11 21 0 8-5 15-11 15S13 35 13 27c0-7 4-15 11-21Z" />
				<path pathLength="1" d="M24 11v29" />
				<path pathLength="1" d="M18 20c2 2 4 3 6 3s4-1 6-3" />
				<path pathLength="1" d="M18 29c2 2 4 3 6 3s4-1 6-3" />
			</>
		)
	}
	{
		name === "beans" && (
			<>
				<path pathLength="1" d="M21 8c5 4 7 11 5 18-2 7-7 12-12 13-4-5-4-13-1-20 2-6 5-9 8-11Z" />
				<path pathLength="1" d="M32 14c4 5 5 12 2 18-2 5-6 8-10 9" />
			</>
		)
	}
	{
		name === "sprout" && (
			<>
				<path pathLength="1" d="M24 42V22" />
				<path pathLength="1" d="M24 24c0-6 4-11 10-12 0 7-4 12-10 12Z" />
				<path pathLength="1" d="M24 30c-6 0-10-5-10-11 6 1 10 5 10 11Z" />
			</>
		)
	}
	{
		name === "flower" && (
			<>
				<circle pathLength="1" cx="24" cy="24" r="3.5" />
				<path pathLength="1" d="M24 20.5c1-5 4-8 4-12 0-2-2-3-4-3s-4 1-4 3c0 4 3 7 4 12Z" />
				<path pathLength="1" d="M27.5 24c5-1 8-4 12-4 2 0 3 2 3 4s-1 4-3 4c-4 0-7-3-12-4Z" />
				<path pathLength="1" d="M24 27.5c-1 5-4 8-4 12 0 2 2 3 4 3s4-1 4-3c0-4-3-7-4-12Z" />
				<path pathLength="1" d="M20.5 24c-5 1-8 4-12 4-2 0-3-2-3-4s1-4 3-4c4 0 7 3 12 4Z" />
			</>
		)
	}
	{
		name === "lattice" && (
			<>
				<path pathLength="1" d="M24 6 42 24 24 42 6 24 24 6Z" />
				<path pathLength="1" d="M24 12v24M12 24h24" />
				<path pathLength="1" d="M17 17c4 3 6 5 7 7M31 17c-4 3-6 5-7 7" />
			</>
		)
	}
</svg>
