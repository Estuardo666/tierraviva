---
import { copy, type Locale } from "../i18n";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = copy[lang].credentials;
---

<div
	class="strip"
	role="group"
	aria-label={t.label}
	style="-webkit-backdrop-filter: blur(18px) saturate(115%); backdrop-filter: blur(18px) saturate(115%);"
>
	<div class="shell">
		<dl>
			{
				t.items.map(([key, value]) => (
					<div>
						<dt>{key}</dt>
						<dd>{value}</dd>
					</div>
				))
			}
		</dl>
	</div>
</div>

<style>
	.strip {
		position: absolute;
		inset-inline: 0;
		inset-block-end: 0;
		z-index: 2;
		background: color-mix(in srgb, var(--color-blue) 14%, transparent);
		color: var(--color-cream);
		border-top: 1px solid color-mix(in srgb, var(--color-cream) 14%, transparent);
		border-bottom: 1px solid color-mix(in srgb, var(--color-cream) 10%, transparent);
		box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-cream) 7%, transparent);
	}

	dl {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	dl > div {
		padding: 0.9rem 0.75rem;
	}

	dl > div:nth-child(even) {
		border-left: 1px solid color-mix(in srgb, var(--color-cream) 12%, transparent);
	}

	dl > div:nth-child(n + 3) {
		border-top: 1px solid color-mix(in srgb, var(--color-cream) 12%, transparent);
	}

	dt {
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-orange);
		margin-bottom: 0.35rem;
	}

	dd {
		font-size: clamp(0.8125rem, 2.8vw, 1rem);
		font-weight: 200;
		line-height: 1.35;
	}

	/* Columns divided by hairlines, not a chain of middots. */
	@media (min-width: 768px) {
		dl {
			grid-template-columns: repeat(4, 1fr);
		}

		dl > div {
			padding-block: 1.6rem;
			padding-inline: 1.75rem;
			border-top: 0;
			border-left: 1px solid color-mix(in srgb, var(--color-cream) 12%, transparent);
		}

		dl > div:first-child {
			border-left: 0;
			padding-inline-start: 0;
		}
	}

	@media (prefers-reduced-transparency: reduce) {
		.strip {
			background: color-mix(in srgb, var(--color-blue) 92%, transparent);
			-webkit-backdrop-filter: none !important;
			backdrop-filter: none !important;
		}
	}
</style>
