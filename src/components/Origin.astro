---
import { copy, type Locale } from "../i18n";

const photo = "/media/origin.jpg";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = copy[lang].origin;
---

<section class="band" id="origin">
	<div class="shell split" data-stagger>
		<figure class="media" data-reveal data-img-reveal>
			<!-- TODO: real farm photograph, 1200x1500 -->
			<img src={photo} alt={t.alt} width="1200" height="1500" loading="lazy" decoding="async" />
		</figure>

		<div class="copy" data-reveal style="--reveal-delay:80ms">
			<h2 class="t-h2">{t.title}</h2>
			<p class="t-body">{t.body1}</p>
			<p class="t-body">{t.body2}</p>
			<p class="pending">{t.pending}</p>
		</div>
	</div>
</section>

<style>
	.split {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}

	@media (min-width: 860px) {
		.split {
			grid-template-columns: 0.85fr 1fr;
			gap: 4.5rem;
		}
	}

	figure {
		margin: 0;
		aspect-ratio: 4 / 5;
	}

	h2 {
		margin-bottom: 1.5rem;
		max-width: 16ch;
	}

	.copy p + p {
		margin-top: 1.125rem;
	}

	.t-body {
		color: var(--color-ink-70);
	}

	.pending {
		margin-top: 2rem;
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		color: var(--color-ink-45);
		border-left: 2px solid var(--color-sand);
		padding-left: 0.875rem;
	}
</style>
