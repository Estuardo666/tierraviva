---
import BrandIcon from "./BrandIcon.astro";
---

<section class="band">
	<div class="shell grid-asym" data-stagger>
		<article data-reveal>
			<BrandIcon name="sprout" class="ico" data-draw />
			<h3 class="t-h3">Grown by the people who read the land</h3>
			<p class="t-body">
				Our own farm and a group of partner growers work the same agroforestry system:
				native shade, living soil, cacao under canopy rather than in place of it.
			</p>
		</article>

		<article data-reveal style="--reveal-delay:90ms">
			<BrandIcon name="pod" class="ico" data-draw />
			<h3 class="t-h3">Fermented in one place, to one protocol</h3>
			<p class="t-body">
				Pods from every plot converge on a single fermentation facility. One protocol,
				documented and measured, so a lot tastes the way the last one did.
			</p>
		</article>
	</div>
</section>

<style>
	.grid-asym {
		display: grid;
		gap: 3rem;
	}

	@media (min-width: 860px) {
		.grid-asym {
			grid-template-columns: 1.25fr 1fr;
			gap: 5rem;
		}
	}

	article :global(.ico) {
		width: 44px;
		height: 44px;
		color: var(--color-orange-ink);
		margin-bottom: 1.5rem;
	}

	h3 {
		margin-bottom: 0.875rem;
		max-width: 18ch;
	}

	p {
		color: var(--color-ink-70);
	}
</style>
