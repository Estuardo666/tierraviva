---
import BrandIcon from "./BrandIcon.astro";
import { copy, type Locale } from "../i18n";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const [growers, fermentation] = copy[lang].value;
---

<section class="band">
	<div class="shell grid-asym" data-stagger>
		<article data-reveal>
			<BrandIcon name="sprout" class="ico" data-draw />
			<h3 class="t-h3">{growers.title}</h3>
			<p class="t-body">{growers.body}</p>
		</article>

		<article data-reveal style="--reveal-delay:90ms">
			<BrandIcon name="pod" class="ico" data-draw />
			<h3 class="t-h3">{fermentation.title}</h3>
			<p class="t-body">{fermentation.body}</p>
		</article>
	</div>
</section>

<style>
	.grid-asym {
		display: grid;
		gap: 3rem;
	}

	@media (min-width: 860px) {
		.grid-asym {
			grid-template-columns: 1.25fr 1fr;
			gap: 5rem;
		}
	}

	article :global(.ico) {
		width: 44px;
		height: 44px;
		color: var(--color-orange-ink);
		margin-bottom: 1.5rem;
	}

	h3 {
		margin-bottom: 0.875rem;
		max-width: 18ch;
	}

	p {
		color: var(--color-ink-70);
	}
</style>
